# --- Devin (server-side; never shared with Grok) ---
# Create at https://app.devin.ai -> Settings -> API Keys. Starts with "apk_".
DEVIN_API_KEY=apk_your_devin_api_key_here

# Devin API base. Leave as-is unless you're on a dedicated/enterprise host.
DEVIN_API_BASE=https://api.devin.ai/v1

# --- Auth between Grok and this plugin ---
# A long random secret. Grok sends this as its Authorization bearer token.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PLUGIN_BEARER_TOKEN=change_me_to_a_long_random_string

# --- Server bind ---
HOST=0.0.0.0
PORT=8000
